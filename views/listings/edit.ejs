   <% layout("/layouts/boilerplate")%>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>Edit your Listing</h3>
    <form enctype="multipart/form-data" method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">
  
      <div class="mb-3">
      <label for="title" class="form-label">Title</label>     
      <input required name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" />
            <div class="valid-feedback">Title looks good</div>

      </div>
      <div class="mb-3">
    <label for="category" class="form-label">Category</label>

    <select name="listing[category]" id="category" class="form-select" required>
        <option value="" selected disabled>Select a category</option>

        <option value="Trending">Trending</option>
        <option value="Rooms">Rooms</option>
        <option value="Iconic Cities">Iconic Cities</option>
        <option value="Mountain">Mountain</option>
        <option value="Amazing Pools">Amazing Pools</option>
        <option value="Castles">Castles</option>
        <option value="Farms">Farms</option>
        <option value="Camping">Camping</option>
        <option value="Adventures">Adventures</option>
        <option value="Beaches">Beaches</option>
        <option value="Sailing">Sailing</option>
        <option value="Wedding">Wedding Derstinations</option>
    </select>
</div>
       <div class="mb-3">
       <label for="description" class="form-label">Description</label>     
         <textarea  required name="listing[description]" id=""  class="form-control"><%= listing.description %></textarea>
                <div class="invalid-feedback">Please enter the description.</div>

        </div>
    <!-- <div class="mb-3">
     <label for="image" class="form-label">Image Link</label>     
     <input required type="text" name="listing[image]" id="" value="<%= listing.image.url%>" class="form-control" >
                   <div class="invalid-feedback">Enter a valid link.</div> -->
 
     <div class="mb-3">
      <h4>Original Image:</h4>
       <img style="height:250px;  width: 350px; border-radius: 10%;" src="<%=originalImageUrl%>">
     </div>              
    <div class="mb-3">
     <label for="image" class="form-label">Upload New Image</label>     
     <input  type="file" name="listing[image]" id=""  class="form-control" >
    </div>
    <div class="row">
     <div class="mb-3 col-md-4">
      <label for="price" class="form-label">Price</label>     
      <input required type="text" name="listing[price]" id="" value="<%= listing.price %>"  type="number" class="form-control" >
              <div class="invalid-feedback">Price should be valid</div>

    </div>
     <div class="mb-3 col-md-8">
     <label for="country" class="form-label">Country</label>     
     <input required type="text" name="listing[country]" id=""  value="<%= listing.country %>"  class="form-control" >
              <div class="invalid-feedback">Country shoud be valid.</div>

    </div>
    </div>
     <div class="mb-3">
     <label for="location" class="form-label">Location</label>     
     <input required type="text" name="listing[location]" id=""  value="<%= listing.location %>" class="form-control">
              <div class="invalid-feedback">Location should be valid.</div>
    </div>
      <button class="btn btn-dark edit-btn mb-3">Edit</button>
    </form>
  </div>
</div>
 